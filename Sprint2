        "%%writefile src/coleta_api.py\n",
        "import os\n",
        "import time\n",
        "import json\n",
        "import logging\n",
        "from datetime import datetime\n",
        "import requests\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n",
        "\n",
        "# Endpoint REST Oficial do IBGE para os distritos/localidades de Palmas-TO (Código IBGE: 1721000)\n",
        "IBGE_REST_PALMAS = \"https://servicodados.ibge.gov.br/api/v1/localidades/municipios/1721000/distritos\"\n",
        "DATA_BRUTO_DIR = os.path.join(\"data\", \"bruto\")\n",
        "\n",
        "def coletar_dados_ibge_rest():\n",
        "    \"\"\"\n",
        "    [E1 - API Real IBGE] Consome a API REST pública oficial do IBGE\n",
        "    para extração de dados territoriais de Palmas-TO (Código IBGE: 1721000).\n",
        "    \"\"\"\n",
        "    logging.info(\"[E1 - API IBGE] Requisitando endpoint REST oficial do IBGE (Palmas-TO)...\")\n",
        "    # Cabeçalho limpo em formato ASCII estrito para evitar erro 400 Bad Request\n",
        "    headers = {\"User-Agent\": \"UFT-BIIA-Integrador/1.0 (Pesquisa Academica UFT Palmas)\"}\n",
        "\n",
        "    try:\n",
        "        response = requests.get(IBGE_REST_PALMAS, headers=headers, timeout=10)\n",
        "        response.raise_for_status()\n",
        "        dados_ibge = response.json()\n",
        "        logging.info(f\"[E1 - API IBGE] Sucesso: {len(dados_ibge)} distritos/regiões retornados pela API oficial do IBGE.\")\n",
        "        return dados_ibge\n",
        "    except Exception as e:\n",
        "        logging.warning(f\"[E1 - API IBGE] Falha ao consultar IBGE ({e}). Retornando estrutura de contingência.\")\n",
        "        return [{\"id\": 1721000, \"nome\": \"Palmas\", \"municipio\": {\"id\": 1721000, \"nome\": \"Palmas\"}}]\n",
        "\n",
        "def gerar_carteira_sefin_modelada(limite_registros=500):\n",
        "    \"\"\"\n",
        "    [E1 - Modelagem Fiscal Sefin]\n",
        "    Nota de Transparência Acadêmica: Como a Sefin Palmas não possui API pública aberta\n",
        "    para dados nominais de devedores (LGPD/CTN), este módulo gera a carga fiscal\n",
        "    respeitando o Dicionário de Dados e o Model Card (Prof. David Nadler Prata).\n",
        "    \"\"\"\n",
        "    logging.info(\"[E1 - Sefin Model] Gerando carteira tributária padronizada conforme Model Card Sefin...\")\n",
        "    setores = [\"Plano Diretor Sul\", \"Plano Diretor Norte\", \"Taquaralto\", \"Aureny III\", \"Luzimangues\"]\n",
        "    tributos = [\"IPTU\", \"ISSQN\", \"ITBI\"]\n",
        "\n",
        "    registros = []\n",
        "    for i in range(1, limite_registros + 1):\n",
        "        inscricao_mun = f\"INSCR_MUN_{1721000 + i:07d}\"\n",
        "        cpf_mascarado = f\"***.{((i * 137) % 899 + 100):03d}.{((i * 43) % 89 + 10):02d}-**\"\n",
        "        ano = 2021 + (i % 5)\n",
        "        mes = (i % 12) + 1\n",
        "\n",
        "        registros.append({\n",
        "            \"id_contribuinte\": inscricao_mun,\n",
        "            \"inscricao_municipal\": inscricao_mun,\n",
        "            \"cpf_cnpj_mascarado\": cpf_mascarado,\n",
        "            \"setor_urbano\": setores[i % len(setores)],\n",
        "            \"tipo_tributo\": tributos[i % len(tributos)],\n",
        "            \"valor_devido\": round(1250.00 + ((i * 517.85) % 62000), 2),\n",
        "            \"data_vencimento\": f\"{ano}-{mes:02d}-15\",\n",
        "            \"exercicio\": ano,\n",
        "            \"orgao_emissor\": \"Secretaria Municipal da Fazenda de Palmas (Sefin)\",\n",
        "            \"origem_modelo\": \"Especificação Técnica Model Card Sefin Palmas\",\n",
        "            \"timestamp_coleta\": datetime.now().isoformat()\n",
        "        })\n",
        "\n",
        "        if i % 100 == 0:\n",
        "            time.sleep(0.05)\n",
        "\n",
        "    return registros\n",
        "\n",
        "def executar_coleta_pipeline():\n",
        "    os.makedirs(DATA_BRUTO_DIR, exist_ok=True)\n",
        "\n",
        "    # 1. Coleta via REST API real do IBGE\n",
        "    dados_ibge = coletar_dados_ibge_rest()\n",
        "\n",
        "    # 2. Carga tributária conforme especificações da Sefin\n",
        "    dados_fiscais = gerar_carteira_sefin_modelada(500)\n",
        "\n",
        "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "    caminho_fiscal = os.path.join(DATA_BRUTO_DIR, f\"devedores_bruto_{timestamp}.json\")\n",
        "    caminho_ibge = os.path.join(DATA_BRUTO_DIR, f\"ibge_api_palmas_{timestamp}.json\")\n",
        "\n",
        "    with open(caminho_fiscal, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(dados_fiscais, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "    with open(caminho_ibge, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(dados_ibge, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "    logging.info(\"[E1] Extração concluída com sucesso:\")\n",
        "    logging.info(f\" -> Dados IBGE (REST API Real): {caminho_ibge}\")\n",
        "    logging.info(f\" -> Dados Fiscais (Schema Sefin): {caminho_fiscal}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    executar_coleta_pipeline()"
      ],
