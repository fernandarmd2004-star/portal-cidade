        "# Conexão com banco SQLite em memória/arquivo local no Colab\n",
        "conn = sqlite3.connect(\"inteligencia_tributaria_palmas.db\")\n",
        "cursor = conn.cursor()\n",
        "\n",
        "# Habilitar chaves estrangeiras\n",
        "cursor.execute(\"PRAGMA foreign_keys = ON;\")\n",
        "\n",
        "# Script DDL - Normalização em 3FN\n",
        "ddl_script = \"\"\"\n",
        "DROP TABLE IF EXISTS Score_Recuperabilidade;\n",
        "DROP TABLE IF EXISTS Debito_Divida_Ativa;\n",
        "DROP TABLE IF EXISTS Imovel;\n",
        "DROP TABLE IF EXISTS Contribuinte;\n",
        "\n",
        "CREATE TABLE Contribuinte (\n",
        "    id_contribuinte INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "    cpf_cnpj_hash TEXT UNIQUE NOT NULL,\n",
        "    nome_alias TEXT NOT NULL,\n",
        "    tipo_pessoa TEXT CHECK(tipo_pessoa IN ('PF', 'PJ')) NOT NULL\n",
        ");\n",
        "\n",
        "CREATE TABLE Imovel (\n",
        "    id_imovel INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "    inscricao_imobiliaria TEXT UNIQUE NOT NULL,\n",
        "    bairro TEXT NOT NULL,\n",
        "    quadra TEXT,\n",
        "    lote TEXT,\n",
        "    cep TEXT\n",
        ");\n",
        "\n",
        "CREATE TABLE Debito_Divida_Ativa (\n",
        "    id_debito INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "    id_contribuinte INTEGER NOT NULL,\n",
        "    id_imovel INTEGER NOT NULL,\n",
        "    valor_principal REAL NOT NULL,\n",
        "    multa_juros REAL NOT NULL,\n",
        "    exercicio INTEGER NOT NULL,\n",
        "    status_debito TEXT DEFAULT 'EM_ABERTO',\n",
        "    FOREIGN KEY (id_contribuinte) REFERENCES Contribuinte(id_contribuinte),\n",
        "    FOREIGN KEY (id_imovel) REFERENCES Imovel(id_imovel)\n",
        ");\n",
        "\n",
        "CREATE TABLE Score_Recuperabilidade (\n",
        "    id_score INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "    id_debito INTEGER UNIQUE NOT NULL,\n",
        "    score_valor REAL NOT NULL,\n",
        "    categoria TEXT CHECK(categoria IN ('ALTA', 'MEDIA', 'BAIXA')) NOT NULL,\n",
        "    data_calculo DATE DEFAULT (DATE('now')),\n",
        "    FOREIGN KEY (id_debito) REFERENCES Debito_Divida_Ativa(id_debito)\n",
        ");\n",
        "\"\"\"\n",
        "\n",
        "cursor.executescript(ddl_script)\n",
        "conn.commit()\n",
        "print(\"✅ Tabelas relacionais criadas em 3FN no SQLite!\")"
