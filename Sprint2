        "%%writefile src/estruturas/estruturas_dados.py\n",
        "import heapq\n",
        "import networkx as nx\n",
        "\n",
        "class TabelaHashIndexador:\n",
        "    \"\"\"Indexação rápida utilizando Tabela Hash - Pesquisa O(1)\"\"\"\n",
        "    def __init__(self):\n",
        "        self._tabela = {}\n",
        "\n",
        "    def inserir(self, chave: str, dados: dict):\n",
        "        self._tabela[chave] = dados\n",
        "\n",
        "    def procurar(self, chave: str) -> dict:\n",
        "        return self._tabela.get(chave, None)\n",
        "\n",
        "\n",
        "class MaxHeapFilaCobranca:\n",
        "    \"\"\"Fila de prioridade de cobrança com Max-Heap - O(log N)\"\"\"\n",
        "    def __init__(self):\n",
        "        self._heap = []\n",
        "\n",
        "    def adicionar(self, id_debito: int, score: float, valor: float):\n",
        "        # Valor negativo de score simula Max-Heap com heapq do Python\n",
        "        heapq.heappush(self._heap, (-score, id_debito, valor))\n",
        "\n",
        "    def extrair_proximo(self) -> dict:\n",
        "        if not self._heap:\n",
        "            return None\n",
        "        neg_score, id_debito, valor = heapq.heappop(self._heap)\n",
        "        return {\"id_debito\": id_debito, \"score\": -neg_score, \"valor\": valor}\n",
        "\n",
        "\n",
        "class GrafoRelacoesTributarias:\n",
        "    \"\"\"Grafo para mapear vínculos Contribuinte-Imóvel-Processo - O(V + E)\"\"\"\n",
        "    def __init__(self):\n",
        "        self.grafo = nx.Graph()\n",
        "\n",
        "    def adicionar_ligacao(self, no_a: str, tipo_a: str, no_b: str, tipo_b: str):\n",
        "        self.grafo.add_node(no_a, tipo=tipo_a)\n",
        "        self.grafo.add_node(no_b, tipo=tipo_b)\n",
        "        self.grafo.add_edge(no_a, no_b)\n",
        "\n",
        "    def obter_vizinhos(self, no: str) -> list:\n",
        "        if no in self.grafo:\n",
        "            return list(self.grafo.neighbors(no))\n",
        "        return []"
      ],
