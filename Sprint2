        "%%writefile src_etl_sefin.py\n",
        "import os\n",
        "import glob\n",
        "import json\n",
        "import sqlite3\n",
        "import logging\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datetime import datetime\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n",
        "\n",
        "DB_PATH = \"inteligencia_tributaria_palmas.db\"\n",
        "DIR_BRUTO = os.path.join(\"data\", \"bruto\")\n",
        "DIR_LIMPO = os.path.join(\"data\", \"limpo\")\n",
        "DIR_PRONTO = os.path.join(\"data\", \"pronto\")\n",
        "\n",
        "for folder in [DIR_BRUTO, DIR_LIMPO, DIR_PRONTO, \"src\", \"docs\"]:\n",
        "    os.makedirs(folder, exist_ok=True)\n",
        "\n",
        "def carregar_dados_brutos_mais_recentes():\n",
        "    arquivos = glob.glob(os.path.join(DIR_BRUTO, \"devedores_bruto_*.json\"))\n",
        "    if not arquivos:\n",
        "        raise FileNotFoundError(\"Nenhum arquivo bruto encontrado em data/bruto/. Execute a coleta primeiro.\")\n",
        "    arquivo_mais_recente = max(arquivos, key=os.path.getctime)\n",
        "    logging.info(f\"Lendo dados brutos de: {arquivo_mais_recente}\")\n",
        "    with open(arquivo_mais_recente, \"r\", encoding=\"utf-8\") as f:\n",
        "        return pd.DataFrame(json.load(f))\n",
        "\n",
        "def enriquecer_dados_ibge():\n",
        "    return pd.DataFrame({\n",
        "        \"setor_urbano\": [\"Plano Diretor Sul\", \"Plano Diretor Norte\", \"Taquaralto\", \"Aureny III\", \"Luzimangues\"],\n",
        "        \"renda_media_setor\": [4850.00, 3200.00, 1850.00, 1600.00, 2100.00],\n",
        "        \"idhm_setor\": [0.821, 0.765, 0.680, 0.665, 0.690],\n",
        "        \"populacao_estimada\": [65000, 58000, 42000, 38000, 25000]\n",
        "    })\n",
        "\n",
        "def executar_pipeline_etl():\n",
        "    logging.info(\"--- INICIANDO PIPELINE ETL (SEFIN PALMAS) ---\")\n",
        "    df_raw = carregar_dados_brutos_mais_recentes()\n",
        "\n",
        "    df_clean = df_raw.copy()\n",
        "    df_clean.dropna(subset=[\"id_contribuinte\", \"valor_devido\", \"data_vencimento\"], inplace=True)\n",
        "    df_clean[\"valor_devido\"] = pd.to_numeric(df_clean[\"valor_devido\"], errors=\"coerce\")\n",
        "    df_clean = df_clean[df_clean[\"valor_devido\"] > 0]\n",
        "    df_clean.drop_duplicates(subset=[\"id_contribuinte\", \"data_vencimento\", \"tipo_tributo\"], inplace=True)\n",
        "\n",
        "    df_clean.to_csv(os.path.join(DIR_LIMPO, \"devedores_limpo.csv\"), index=False)\n",
        "\n",
        "    df_transformed = df_clean.copy()\n",
        "    df_transformed[\"data_vencimento\"] = pd.to_datetime(df_transformed[\"data_vencimento\"])\n",
        "    data_referencia = pd.to_datetime(\"2026-10-27\")\n",
        "\n",
        "    df_transformed[\"dias_inadimplencia\"] = (data_referencia - df_transformed[\"data_vencimento\"]).dt.days\n",
        "    df_transformed[\"dias_inadimplencia\"] = df_transformed[\"dias_inadimplencia\"].apply(lambda x: max(x, 0))\n",
        "    df_transformed[\"mes_vencimento\"] = df_transformed[\"data_vencimento\"].dt.month\n",
        "    df_transformed[\"trimestre_vencimento\"] = df_transformed[\"data_vencimento\"].dt.quarter\n",
        "\n",
        "    bins_valor = [0, 2000, 10000, 50000, np.inf]\n",
        "    labels_valor = [\"Baixo (< 2k)\", \"Médio (2k - 10k)\", \"Alto (10k - 50k)\", \"Crítico (> 50k)\"]\n",
        "    df_transformed[\"faixa_valor\"] = pd.cut(df_transformed[\"valor_devido\"], bins=bins_valor, labels=labels_valor)\n",
        "\n",
        "    df_ibge = enriquecer_dados_ibge()\n",
        "    df_final = pd.merge(df_transformed, df_ibge, on=\"setor_urbano\", how=\"left\")\n",
        "\n",
        "    df_final.to_csv(os.path.join(DIR_PRONTO, \"devedores_enriquecido.csv\"), index=False)\n",
        "\n",
        "    conn = sqlite3.connect(DB_PATH)\n",
        "    df_final[\"data_vencimento\"] = df_final[\"data_vencimento\"].dt.strftime(\"%Y-%m-%d\")\n",
        "    df_final[\"faixa_valor\"] = df_final[\"faixa_valor\"].astype(str)\n",
        "    df_final[\"data_processamento\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "\n",
        "    df_final.to_sql(\"divida_ativa_sprint3\", conn, if_exists=\"replace\", index=False)\n",
        "    conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "    logging.info(f\"Carga concluída! {len(df_final)} linhas inseridas na tabela 'divida_ativa_sprint3'.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    executar_pipeline_etl()"
      ],
