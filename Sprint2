        "import os\n",
        "import sqlite3\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import folium\n",
        "from folium.plugins import HeatMap\n",
        "\n",
        "DB_PATH = \"inteligencia_tributaria_palmas.db\"\n",
        "DOCS_DIR = \"docs\"\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "def gerar_eda_e_mapa():\n",
        "    conn = sqlite3.connect(DB_PATH)\n",
        "    df = pd.read_sql(\"SELECT * FROM divida_ativa_sprint3\", conn)\n",
        "    conn.close()\n",
        "\n",
        "    # 1. Gráfico de Evolução (Evolução por Exercício)\n",
        "    plt.figure(figsize=(8, 4.5))\n",
        "    df_evol = df.groupby(\"exercicio\")[\"valor_devido\"].sum().reset_index()\n",
        "    sns.lineplot(data=df_evol, x=\"exercicio\", y=\"valor_devido\", marker=\"o\", color=\"darkblue\", linewidth=2.5)\n",
        "    plt.title(\"Evolução Temporal do Passivo Devido por Exercício Fiscal\", fontsize=11, fontweight=\"bold\")\n",
        "    plt.xlabel(\"Exercício Fiscal\")\n",
        "    plt.ylabel(\"Montante Devido (R$)\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(DOCS_DIR, \"grafico_evolucao.png\"), dpi=300)\n",
        "    plt.close()\n",
        "\n",
        "    # 2. Gráfico de Composição (Por Tipo de Tributo)\n",
        "    plt.figure(figsize=(8, 4.5))\n",
        "    df_comp = df.groupby(\"tipo_tributo\")[\"valor_devido\"].sum().reset_index()\n",
        "    sns.barplot(data=df_comp, x=\"tipo_tributo\", y=\"valor_devido\", hue=\"tipo_tributo\", palette=\"Blues_d\", legend=False)\n",
        "    plt.title(\"Composição da Dívida Ativa por Tipo de Tributo Municipal\", fontsize=11, fontweight=\"bold\")\n",
        "    plt.xlabel(\"Tipo de Tributo\")\n",
        "    plt.ylabel(\"Montante Devido (R$)\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(DOCS_DIR, \"grafico_composicao.png\"), dpi=300)\n",
        "    plt.close()\n",
        "\n",
        "    # 3. Gráfico de Distribuição (Por Faixas de Valor)\n",
        "    plt.figure(figsize=(8, 4.5))\n",
        "    order_faixas = [\"Baixo (< 2k)\", \"Médio (2k - 10k)\", \"Alto (10k - 50k)\", \"Crítico (> 50k)\"]\n",
        "    sns.countplot(data=df, x=\"faixa_valor\", hue=\"faixa_valor\", palette=\"Reds_d\", order=order_faixas, legend=False)\n",
        "    plt.title(\"Distribuição da Frequência de Contribuintes por Faixa de Valor\", fontsize=11, fontweight=\"bold\")\n",
        "    plt.xlabel(\"Faixa de Valor Devido\")\n",
        "    plt.ylabel(\"Quantidade de Devedores\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(DOCS_DIR, \"grafico_distribuicao.png\"), dpi=300)\n",
        "    plt.close()\n",
        "\n",
        "    # 4. Gráfico de Relação (Renda IBGE x Passivo Devido)\n",
        "    plt.figure(figsize=(8, 4.5))\n",
        "    df_rel = df.groupby(\"setor_urbano\").agg(\n",
        "        total_devido=(\"valor_devido\", \"sum\"),\n",
        "        renda_media=(\"renda_media_setor\", \"first\")\n",
        "    ).reset_index()\n",
        "    sns.scatterplot(data=df_rel, x=\"renda_media\", y=\"total_devido\", hue=\"setor_urbano\", s=180)\n",
        "    plt.title(\"Relação entre Renda Média Setorial (IBGE) e Montante Inadimplente\", fontsize=11, fontweight=\"bold\")\n",
        "    plt.xlabel(\"Renda Média Setorial (R$)\")\n",
        "    plt.ylabel(\"Montante Acumulado Devido (R$)\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(DOCS_DIR, \"grafico_relacao.png\"), dpi=300)\n",
        "    plt.close()\n",
        "\n",
        "    # 5. Mapa Geoespacial Interativo com Camada de Calor (HeatMap)\n",
        "    coords_setores = {\n",
        "        \"Plano Diretor Sul\": [-10.2128, -48.3327],\n",
        "        \"Plano Diretor Norte\": [-10.1689, -48.3311],\n",
        "        \"Taquaralto\": [-10.3200, -48.2980],\n",
        "        \"Aureny III\": [-10.2850, -48.3010],\n",
        "        \"Luzimangues\": [-10.1500, -48.3800]\n",
        "    }\n",
        "\n",
        "    mapa_palmas = folium.Map(location=[-10.25, -48.32], zoom_start=11, tiles=\"OpenStreetMap\")\n",
        "    heat_data = []\n",
        "\n",
        "    df_map_agg = df.groupby(\"setor_urbano\").agg(\n",
        "        total_devido=(\"valor_devido\", \"sum\"),\n",
        "        qtd_devedores=(\"id_contribuinte\", \"count\")\n",
        "    ).reset_index()\n",
        "\n",
        "    for _, row in df_map_agg.iterrows():\n",
        "        setor = row[\"setor_urbano\"]\n",
        "        if setor in coords_setores:\n",
        "            lat, lon = coords_setores[setor]\n",
        "            heat_data.append([lat, lon, row[\"total_devido\"] / 10000.0])\n",
        "            folium.CircleMarker(\n",
        "                location=[lat, lon],\n",
        "                radius=max(row[\"qtd_devedores\"] / 5, 7),\n",
        "                popup=f\"<b>{setor}</b><br>Total Devido: R$ {row['total_devido']:,.2f}\",\n",
        "                color=\"darkred\",\n",
        "                fill=True,\n",
        "                fill_color=\"red\"\n",
        "            ).add_to(mapa_palmas)\n",
        "\n",
        "    HeatMap(heat_data, radius=25, blur=15, max_zoom=13).add_to(mapa_palmas)\n",
        "    mapa_palmas.save(os.path.join(DOCS_DIR, \"mapa_inadimplencia_palmas.html\"))\n",
        "\n",
        "    # 6. Compilação do Relatório Markdown de EDA\n",
        "    relatorio_md = f\"\"\"# Relatório de Análise Exploratória de Dados (EDA) — Sefin Palmas\n",
        "\n",
        "## 1. Métricas Globais da Carteira\n",
        "- **Montante Total Mapeado:** R$ {df['valor_devido'].sum():,.2f}\n",
        "- **Total de Contribuintes Processados:** {len(df)}\n",
        "- **Tempo Médio de Atraso:** {df['dias_inadimplencia'].mean():.1f} dias\n",
        "- **Casos em Prioridade Alta:** {len(df[df['flag_prioridade_cobranca'] == 'ALTA'])}\n",
        "\n",
        "---\n",
        "\n",
        "## 2. Visualizações Estatísticas e Frases de Leitura\n",
        "\n",
        "### A. Evolução Temporal\n",
        "![Evolução](grafico_evolucao.png)\n",
        "> **Frase de Leitura:** *\"A evolução temporal demonstra acúmulo progressivo do passivo fiscal ao longo dos exercícios recentes, destacando a necessidade de ações preventivas de cobrança amigável antes do vencimento do segundo ano de inadimplência.\"*\n",
        "\n",
        "### B. Composição da Dívida\n",
        "![Composição](grafico_composicao.png)\n",
        "> **Frase de Leitura:** *\"O IPTU figura como a principal fonte geradora do passivo tributário municipal de Palmas, seguido pelas pendências relativas ao ISSQN e ITBI.\"*\n",
        "\n",
        "### C. Distribuição por Faixa de Valor\n",
        "![Distribuição](grafico_distribuicao.png)\n",
        "> **Frase de Leitura:** *\"A maior concentração do número de devedores situa-se nas faixas de valor baixo e médio, porém a menor parcela na faixa crítica (> 50k) responde pelo maior risco de execução fiscal.\"*\n",
        "\n",
        "### D. Relação Socioeconômica (IBGE)\n",
        "![Relação](grafico_relacao.png)\n",
        "> **Frase de Leitura:** *\"Setores com maior renda média setorial apresentam maior concentração de montantes de alto valor, indicando potencial diferenciado de arrecadação em campanhas de cobrança priorizada.\"*\n",
        "\n",
        "---\n",
        "\n",
        "## 3. Diagnóstico Geoespacial\n",
        "O mapa interativo `mapa_inadimplencia_palmas.html` utiliza uma camada de calor (`HeatMap`) para explicitar a densidade geográfica e a distribuição por setores urbanos do passivo tributário em Palmas-TO.\n",
        "\"\"\"\n",
        "    with open(os.path.join(DOCS_DIR, \"relatorio_eda.md\"), \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(relatorio_md)\n",
        "\n",
        "    print(\"[E3] Gráficos, Mapa de Calor e Relatório EDA compilados com sucesso!\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    gerar_eda_e_mapa()"
      ],
