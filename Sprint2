        "# ==========================================\n",
        "# 1. TABELA HASH (Indexação Rápida - Busca O(1))\n",
        "# ==========================================\n",
        "class TabelaHashDivida:\n",
        "    def __init__(self):\n",
        "        self._index = {}\n",
        "\n",
        "    def inserir(self, chave_cpf_cnpj: str, dados_contribuinte: dict):\n",
        "        self._index[chave_cpf_cnpj] = dados_contribuinte\n",
        "\n",
        "    def buscar(self, chave_cpf_cnpj: str) -> dict:\n",
        "        return self._index.get(chave_cpf_cnpj, None)\n",
        "\n",
        "# ==========================================\n",
        "# 2. MAX-HEAP (Fila de Prioridade da Cobrança - O(log N))\n",
        "# ==========================================\n",
        "class FilaPrioridadeCobranca:\n",
        "    def __init__(self):\n",
        "        self._heap = []\n",
        "\n",
        "    def adicionar_debito(self, id_debito: int, score: float, valor: float):\n",
        "        # Em Python, heapq é Min-Heap. Usamos -score para simular Max-Heap.\n",
        "        heapq.heappush(self._heap, (-score, id_debito, valor))\n",
        "\n",
        "    def proximo_prioritario(self):\n",
        "        if not self._heap:\n",
        "            return None\n",
        "        neg_score, id_debito, valor = heapq.heappop(self._heap)\n",
        "        return {\"id_debito\": id_debito, \"score\": -neg_score, \"valor\": valor}\n",
        "\n",
        "# ==========================================\n",
        "# 3. GRAFO (Rede Contribuinte - Imóvel - Processo - O(V + E))\n",
        "# ==========================================\n",
        "class GrafoRelacoesTributarias:\n",
        "    def __init__(self):\n",
        "        self.grafo = nx.Graph()\n",
        "\n",
        "    def adicionar_vinculo(self, no_origem: str, tipo_origem: str, no_destino: str, tipo_destino: str):\n",
        "        self.grafo.add_node(no_origem, tipo=tipo_origem)\n",
        "        self.grafo.add_node(no_destino, tipo=tipo_destino)\n",
        "        self.grafo.add_edge(no_origem, no_destino)\n",
        "\n",
        "    def obter_conexoes(self, no: str):\n",
        "        if no in self.grafo:\n",
        "            return list(self.grafo.neighbors(no))\n",
        "        return []\n",
        "\n",
        "print(\"✅ Estruturas de dados (Hash, Max-Heap e Grafo) instanciadas!\")"
      ],
