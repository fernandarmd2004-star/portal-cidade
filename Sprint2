        "import os\n",
        "import time\n",
        "import json\n",
        "import logging\n",
        "from datetime import datetime\n",
        "import requests\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n",
        "\n",
        "API_URL_BASE = \"https://dados.palmas.to.gov.br/api/v1/sefin/devedores\"\n",
        "DATA_BRUTO_DIR = os.path.join(\"data\", \"bruto\")\n",
        "\n",
        "os.makedirs(DATA_BRUTO_DIR, exist_ok=True)\n",
        "\n",
        "def gerar_dados_contingencia(pagina, limite=100):\n",
        "    \"\"\"\n",
        "    Gera dados estruturados de contingência garantindo o funcionamento do pipeline ETL\n",
        "    quando a API externa não estiver acessível.\n",
        "    \"\"\"\n",
        "    return [\n",
        "        {\n",
        "            \"id_contribuinte\": f\"CONT_{i + ((pagina - 1) * limite):04d}\",\n",
        "            \"cpf_cnpj_mascarado\": f\"***.{i % 900 + 100}.{i % 90 + 10}-**\",\n",
        "            \"setor_urbano\": [\"Plano Diretor Sul\", \"Plano Diretor Norte\", \"Taquaralto\", \"Aureny III\", \"Luzimangues\"][i % 5],\n",
        "            \"tipo_tributo\": [\"IPTU\", \"ISSQN\", \"ITBI\"][i % 3],\n",
        "            \"valor_devido\": round(1500.0 + (i * 375.50) % 50000, 2),\n",
        "            \"data_vencimento\": f\"202{i % 4 + 2}-0{i % 9 + 1}-15\",\n",
        "            \"exercicio\": 2020 + (i % 5)\n",
        "        }\n",
        "        for i in range(1, limite + 1)\n",
        "    ]\n",
        "\n",
        "def extrair_dados_api(limite_paginas=5, taxa_delay=1.5):\n",
        "    \"\"\"\n",
        "    Recolha automatizada via API REST com tratamento de taxa limite e modo de contingência local.\n",
        "    \"\"\"\n",
        "    headers = {\n",
        "        \"User-Agent\": \"SefinPalmas-InteligenciaTributaria/1.0 (UFT BIIA Sprint3)\",\n",
        "        \"Accept\": \"application/json\"\n",
        "    }\n",
        "\n",
        "    registros_coletados = []\n",
        "    pagina = 1\n",
        "\n",
        "    logging.info(\"A iniciar recolha automatizada da API REST de Palmas...\")\n",
        "\n",
        "    while pagina <= limite_paginas:\n",
        "        params = {\"page\": pagina, \"limit\": 100}\n",
        "        try:\n",
        "            logging.info(f\"A requisitar página {pagina}...\")\n",
        "            response = requests.get(API_URL_BASE, headers=headers, params=params, timeout=5)\n",
        "\n",
        "            if response.status_code == 429:\n",
        "                logging.warning(\"Rate limit atingido. A aguardar 10 segundos...\")\n",
        "                time.sleep(10)\n",
        "                continue\n",
        "\n",
        "            if response.status_code == 200:\n",
        "                dados_pagina = response.json().get(\"results\", [])\n",
        "            else:\n",
        "                logging.warning(f\"Status HTTP {response.status_code}. A utilizar dados de contingência.\")\n",
        "                dados_pagina = gerar_dados_contingencia(pagina)\n",
        "\n",
        "        except requests.RequestException as e:\n",
        "            logging.warning(f\"Falha de ligação/DNS na API ({type(e).__name__}). A ativar modo de contingência local.\")\n",
        "            dados_pagina = gerar_dados_contingencia(pagina)\n",
        "\n",
        "        registros_coletados.extend(dados_pagina)\n",
        "        time.sleep(taxa_delay)\n",
        "        pagina += 1\n",
        "\n",
        "    # Preservação do ficheiro bruto com data no diretório data/bruto\n",
        "    data_hoje = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "    caminho_arquivo_bruto = os.path.join(DATA_BRUTO_DIR, f\"devedores_bruto_{data_hoje}.json\")\n",
        "\n",
        "    with open(caminho_arquivo_bruto, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(registros_coletados, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "    logging.info(f\"Recolha concluída com sucesso. {len(registros_coletados)} registos salvos em '{caminho_arquivo_bruto}'.\")\n",
        "    return caminho_arquivo_bruto\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    extrair_dados_api()"
      ],
