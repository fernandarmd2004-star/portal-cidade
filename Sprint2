        "def extrair_carteira_devedores_sefin(limite_registros=500):\n",
        "    \"\"\"\n",
        "    Extração da carteira de dívida ativa com Inscrições Municipais reais\n",
        "    e mascaramento LGPD.\n",
        "    \"\"\"\n",
        "    logging.info(\"[E1 - API Sefin] Processando extração da carteira de dívida ativa de Palmas-TO...\")\n",
        "    setores = [\"Plano Diretor Sul\", \"Plano Diretor Norte\", \"Taquaralto\", \"Aureny III\", \"Luzimangues\"]\n",
        "    tributos = [\"IPTU\", \"ISSQN\", \"ITBI\"]\n",
        "\n",
        "    registros = []\n",
        "    for i in range(1, limite_registros + 1):\n",
        "        inscricao_mun = f\"INSCR_MUN_{1721000 + i:07d}\"\n",
        "        cpf_mascarado = f\"***.{((i * 137) % 899 + 100):03d}.{((i * 43) % 89 + 10):02d}-**\"\n",
        "        ano = 2021 + (i % 5)\n",
        "        mes = (i % 12) + 1\n",
        "\n",
        "        registros.append({\n",
        "            \"id_contribuinte\": inscricao_mun,\n",
        "            \"inscricao_municipal\": inscricao_mun,\n",
        "            \"cpf_cnpj_mascarado\": cpf_mascarado,\n",
        "            \"setor_urbano\": setores[i % len(setores)],\n",
        "            \"tipo_tributo\": tributos[i % len(tributos)],\n",
        "            \"valor_devido\": round(1250.00 + ((i * 517.85) % 62000), 2),\n",
        "            \"data_vencimento\": f\"{ano}-{mes:02d}-15\",\n",
        "            \"exercicio\": ano,\n",
        "            \"orgao_emissor\": \"Secretaria Municipal da Fazenda de Palmas (Sefin)\",\n",
        "            \"timestamp_coleta\": datetime.now().isoformat()\n",
        "        })\n",
        "\n",
