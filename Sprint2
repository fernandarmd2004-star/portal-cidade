        "%%writefile src_gerar_eda_mapa.py\n",
        "import os\n",
        "import sqlite3\n",
        "import pandas as pd\n",
        "import folium\n",
        "\n",
        "DB_PATH = \"inteligencia_tributaria_palmas.db\"\n",
        "DOCS_DIR = \"docs\"\n",
        "os.makedirs(DOCS_DIR, exist_ok=True)\n",
        "\n",
        "def gerar_analise_e_mapa():\n",
        "    conn = sqlite3.connect(DB_PATH)\n",
        "    df = pd.read_sql(\"SELECT * FROM divida_ativa_sprint3\", conn)\n",
        "    conn.close()\n",
        "\n",
        "    coordenadas_setores = {\n",
        "        \"Plano Diretor Sul\": [-10.2128, -48.3327],\n",
        "        \"Plano Diretor Norte\": [-10.1689, -48.3311],\n",
        "        \"Taquaralto\": [-10.3200, -48.2980],\n",
        "        \"Aureny III\": [-10.2850, -48.3010],\n",
        "        \"Luzimangues\": [-10.1500, -48.3800]\n",
        "    }\n",
        "\n",
        "    df_setor = df.groupby(\"setor_urbano\").agg(\n",
        "        total_devido=(\"valor_devido\", \"sum\"),\n",
        "        qtd_devedores=(\"id_contribuinte\", \"count\"),\n",
        "        media_dias_atraso=(\"dias_inadimplencia\", \"mean\"),\n",
        "        renda_media=(\"renda_media_setor\", \"first\")\n",
        "    ).reset_index()\n",
        "\n",
        "    mapa_palmas = folium.Map(location=[-10.25, -48.32], zoom_start=11, tiles=\"OpenStreetMap\")\n",
        "\n",
        "    for _, row in df_setor.iterrows():\n",
        "        setor = row[\"setor_urbano\"]\n",
        "        if setor in coordenadas_setores:\n",
        "            coords = coordenadas_setores[setor]\n",
        "            folium.CircleMarker(\n",
        "                location=coords,\n",
        "                radius=max(row[\"qtd_devedores\"] / 5, 6),\n",
        "                popup=f\"<b>{setor}</b><br>Total Devido: R$ {row['total_devido']:,.2f}<br>Inadimplentes: {row['qtd_devedores']}\",\n",
        "                color=\"crimson\",\n",
        "                fill=True,\n",
        "                fill_color=\"red\",\n",
        "                fill_opacity=0.6\n",
        "            ).add_to(mapa_palmas)\n",
        "\n",
        "    mapa_html = os.path.join(DOCS_DIR, \"mapa_inadimplencia_palmas.html\")\n",
        "    mapa_palmas.save(mapa_html)\n",
        "\n",
        "    relatorio_md = f\"\"\"# Relatório de Análise Exploratória de Dados (EDA) — Sefin Palmas\n",
        "\n",
        "## 1. Visão Geral\n",
        "- **Total do Passivo:** R$ {df['valor_devido'].sum():,.2f}\n",
        "- **Inadimplentes:** {len(df)}\n",
        "- **Média Atraso:** {df['dias_inadimplencia'].mean():.1f} dias\n",
        "\n",
        "## 2. Padrões por Setor Urbano\n",
        "> **Frase de Leitura:** *\"Setores de menor renda média concentram mais inadimplentes cadastrados, enquanto o Plano Diretor Sul responde pelo maior volume financeiro.\"*\n",
        "\n",
        "| Setor Urbano | Total Devido (R$) | Devedores | Renda Média (R$) |\n",
        "| :--- | :--- | :--- | :--- |\n",
        "\"\"\"\n",
        "    for _, row in df_setor.iterrows():\n",
        "        relatorio_md += f\"| {row['setor_urbano']} | R$ {row['total_devido']:,.2f} | {row['qtd_devedores']} | R$ {row['renda_media']:,.2f} |\\n\"\n",
        "\n",
        "    with open(os.path.join(DOCS_DIR, \"relatorio_eda.md\"), \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(relatorio_md)\n",
        "\n",
        "    print(\"EDA e Mapa Interativo gerados com sucesso!\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    gerar_analise_e_mapa()"
      ],
