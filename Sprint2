        "print(\"--- 📌 CONSULTA 1: Ranking de Cobrança Prioritária (RF05) ---\")\n",
        "sql_ranking = \"\"\"\n",
        "SELECT\n",
        "    d.id_debito,\n",
        "    c.nome_alias AS contribuinte,\n",
        "    i.bairro,\n",
        "    (d.valor_principal + d.multa_juros) AS valor_total,\n",
        "    s.score_valor,\n",
        "    s.categoria\n",
        "FROM Debito_Divida_Ativa d\n",
        "JOIN Contribuinte c ON d.id_contribuinte = c.id_contribuinte\n",
        "JOIN Imovel i ON d.id_imovel = i.id_imovel\n",
        "JOIN Score_Recuperabilidade s ON d.id_debito = s.id_debito\n",
        "ORDER BY s.score_valor DESC;\n",
        "\"\"\"\n",
        "df_ranking = pd.read_sql_query(sql_ranking, conn)\n",
        "display(df_ranking)\n",
        "\n",
        "print(\"\\n--- 📌 CONSULTA 2: Inadimplência por Bairro / Mapa de Calor (RF07/RF08) ---\")\n",
        "sql_bairros = \"\"\"\n",
        "SELECT\n",
        "    i.bairro,\n",
        "    COUNT(d.id_debito) AS qtd_debitos,\n",
        "    SUM(d.valor_principal + d.multa_juros) AS total_inadimplente\n",
        "FROM Debito_Divida_Ativa d\n",
        "JOIN Imovel i ON d.id_imovel = i.id_imovel\n",
        "GROUP BY i.bairro\n",
        "ORDER BY total_inadimplente DESC;\n",
        "\"\"\"\n",
        "df_bairros = pd.read_sql_query(sql_bairros, conn)\n",
        "display(df_bairros)\n",
        "\n",
        "print(\"\\n--- 📌 CONSULTA 3: Projeção de Recuperação de Valores por Faixa (RF09) ---\")\n",
        "sql_projecao = \"\"\"\n",
        "SELECT\n",
        "    s.categoria,\n",
        "    COUNT(d.id_debito) AS quantidade,\n",
        "    SUM(d.valor_principal + d.multa_juros) AS montante_total\n",
        "FROM Score_Recuperabilidade s\n",
        "JOIN Debito_Divida_Ativa d ON s.id_debito = d.id_debito\n",
        "GROUP BY s.categoria\n",
