        "%%writefile src/dados/consultas_validacao.sql\n",
        "-- CONSULTA 1: Ranking de Priorização da Cobrança (RF05)\n",
        "SELECT\n",
        "    d.id_debito,\n",
        "    c.nome_alias AS contribuinte,\n",
        "    i.bairro,\n",
        "    (d.valor_principal + d.multa_juros) AS valor_total,\n",
        "    s.score_valor,\n",
        "    s.categoria\n",
        "FROM Debito_Divida_Ativa d\n",
        "JOIN Contribuinte c ON d.id_contribuinte = c.id_contribuinte\n",
        "JOIN Imovel i ON d.id_imovel = i.id_imovel\n",
        "JOIN Score_Recuperabilidade s ON d.id_debito = s.id_debito\n",
        "ORDER BY s.score_valor DESC;\n",
        "\n",
        "-- CONSULTA 2: Inadimplência por Bairro / Mapa de Calor (RF07/RF08)\n",
        "SELECT\n",
        "    i.bairro,\n",
        "    COUNT(d.id_debito) AS quantidade_debitos,\n",
        "    SUM(d.valor_principal + d.multa_juros) AS montante_inadimplente\n",
        "FROM Debito_Divida_Ativa d\n",
        "JOIN Imovel i ON d.id_imovel = i.id_imovel\n",
        "GROUP BY i.bairro\n",
        "ORDER BY montante_inadimplente DESC;\n",
        "\n",
        "-- CONSULTA 3: Projeção de Recuperação de Valores por Categoria (RF09)\n",
        "SELECT\n",
        "    s.categoria,\n",
        "    COUNT(d.id_debito) AS qtd_processos,\n",
        "    SUM(d.valor_principal + d.multa_juros) AS estimativa_recuperacao\n",
        "FROM Score_Recuperabilidade s\n",
        "JOIN Debito_Divida_Ativa d ON s.id_debito = d.id_debito\n",
        "GROUP BY s.categoria\n",
        "ORDER BY CASE s.categoria WHEN 'ALTA' THEN 1 WHEN 'MEDIA' THEN 2 ELSE 3 END;"
