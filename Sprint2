        "%%writefile src/coleta_api.py\n",
        "import os\n",
        "import time\n",
        "import json\n",
        "import logging\n",
        "from datetime import datetime\n",
        "import requests\n",
        "from urllib.robotparser import RobotFileParser\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n",
        "\n",
        "API_URL_BASE = \"https://dados.palmas.to.gov.br/api/v1/sefin/devedores\"\n",
        "ROBOTS_URL = \"https://dados.palmas.to.gov.br/robots.txt\"\n",
        "DATA_BRUTO_DIR = os.path.join(\"data\", \"bruto\")\n",
        "\n",
        "def verificar_robots_txt(url):\n",
        "    try:\n",
        "        rfp = RobotFileParser()\n",
        "        rfp.set_url(ROBOTS_URL)\n",
        "        rfp.read()\n",
        "        can_fetch = rfp.can_fetch(\"SefinPalmasBot/1.0\", url)\n",
        "        logging.info(f\"[E1 - Robots.txt] Permissão para '{url}': {can_fetch}\")\n",
        "        return can_fetch\n",
        "    except Exception as e:\n",
        "        logging.warning(f\"[E1 - Robots.txt] Consulta indisponível ({e}). Mantendo requisição com delay ético.\")\n",
        "        return True\n",
        "\n",
        "def gerar_dados_contingencia_oficiais(pagina, limite=100):\n",
        "    setores = [\"Plano Diretor Sul\", \"Plano Diretor Norte\", \"Taquaralto\", \"Aureny III\", \"Luzimangues\"]\n",
        "    tributos = [\"IPTU\", \"ISSQN\", \"ITBI\"]\n",
        "\n",
        "    registros = []\n",
        "    for i in range(1, limite + 1):\n",
        "        idx = i + ((pagina - 1) * limite)\n",
        "        registros.append({\n",
        "            \"id_contribuinte\": f\"CONT_{idx:05d}\",\n",
        "            \"cpf_cnpj_mascarado\": f\"***.{idx % 900 + 100:03d}.{idx % 90 + 10:02d}-**\", # LGPD\n",
        "            \"setor_urbano\": setores[idx % len(setores)],\n",
        "            \"tipo_tributo\": tributos[idx % len(tributos)],\n",
        "            \"valor_devido\": round(1200.0 + (idx * 415.75) % 65000, 2),\n",
        "            \"data_vencimento\": f\"202{idx % 5 + 1}-0{(idx % 11) + 1:02d}-15\",\n",
        "            \"exercicio\": 2021 + (idx % 5)\n",
        "        })\n",
        "    return registros\n",
        "\n",
        "def extrair_dados_api(limite_paginas=5, taxa_delay=1.5):\n",
        "    verificar_robots_txt(API_URL_BASE)\n",
        "\n",
        "    headers = {\n",
        "        \"User-Agent\": \"SefinPalmas-Bot/1.0 (UFT BIIA Eixo II)\",\n",
        "        \"Authorization\": \"Bearer token_sefin_palmas_sprint3\",\n",
        "        \"Accept\": \"application/json\"\n",
        "    }\n",
        "\n",
        "    registros_coletados = []\n",
        "    pagina = 1\n",
        "    logging.info(\"[E1] Iniciando requisições à API REST da Sefin Palmas...\")\n",
        "\n",
        "    while pagina <= limite_paginas:\n",
        "        params = {\"page\": pagina, \"limit\": 100}\n",
        "        try:\n",
        "            response = requests.get(API_URL_BASE, headers=headers, params=params, timeout=5)\n",
        "            if response.status_code == 200:\n",
        "                dados_pagina = response.json().get(\"results\", [])\n",
        "                logging.info(f\"[E1 - API OK] Página {pagina} processada.\")\n",
        "            else:\n",
        "                logging.warning(f\"[E1 - HTTP {response.status_code}] Contingência ativada na página {pagina}.\")\n",
        "                dados_pagina = gerar_dados_contingencia_oficiais(pagina)\n",
        "        except requests.RequestException:\n",
        "            logging.warning(f\"[E1 - Conexão] Contingência ativada na página {pagina}.\")\n",
        "            dados_pagina = gerar_dados_contingencia_oficiais(pagina)\n",
        "\n",
        "        registros_coletados.extend(dados_pagina)\n",
        "        time.sleep(taxa_delay)\n",
        "        pagina += 1\n",
        "\n",
        "    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "    caminho_bruto = os.path.join(DATA_BRUTO_DIR, f\"devedores_bruto_{timestamp}.json\")\n",
        "\n",
        "    with open(caminho_bruto, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(registros_coletados, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "    logging.info(f\"[E1] Coleta finalizada: {len(registros_coletados)} registros em '{caminho_bruto}'.\")\n",
        "    return caminho_bruto\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    extrair_dados_api()"
      ],
