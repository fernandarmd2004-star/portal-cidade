        "%%writefile src/etl_sefin.py\n",
        "import os\n",
        "import glob\n",
        "import json\n",
        "import sqlite3\n",
        "import logging\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datetime import datetime\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n",
        "\n",
        "DB_PATH = \"inteligencia_tributaria_palmas.db\"\n",
        "DIR_BRUTO = os.path.join(\"data\", \"bruto\")\n",
        "DIR_LIMPO = os.path.join(\"data\", \"limpo\")\n",
        "DIR_PRONTO = os.path.join(\"data\", \"pronto\")\n",
        "\n",
        "def carregar_dados_brutos():\n",
        "    arquivos = glob.glob(os.path.join(DIR_BRUTO, \"devedores_bruto_*.json\"))\n",
        "    if not arquivos:\n",
        "        raise FileNotFoundError(\"Nenhum arquivo encontrado em data/bruto/. Execute src/coleta_api.py.\")\n",
        "    arquivo_recente = max(arquivos, key=os.path.getctime)\n",
        "    logging.info(f\"[E2 - Extração] Lendo dados brutos: {arquivo_recente}\")\n",
        "    with open(arquivo_recente, \"r\", encoding=\"utf-8\") as f:\n",
        "        return pd.DataFrame(json.load(f))\n",
        "\n",
        "def carregar_ibge():\n",
        "    caminho_ibge = os.path.join(DIR_BRUTO, \"ibge_palmas_setores.csv\")\n",
        "    return pd.read_csv(caminho_ibge)\n",
        "\n",
        "def gerar_motivos_xai(row):\n",
        "    motivos = []\n",
        "    motivos.append(\"Inadimplência superior a 2 anos\" if row[\"dias_inadimplencia\"] > 730 else \"Inadimplência sob acompanhamento recente\")\n",
        "    motivos.append(\"Débito de alto valor (>= R$ 10k)\" if row[\"valor_devido\"] >= 10000.0 else \"Débito pulverizado de pequeno porte\")\n",
        "    motivos.append(\"Setor com alta capacidade contributiva\" if row[\"renda_media_setor\"] >= 3000.0 else \"Setor urbano em faixa social prioritária\")\n",
        "    return \" | \".join(motivos)\n",
        "\n",
        "def executar_etl():\n",
        "    logging.info(\"================ INICIANDO ETL (SEFIN PALMAS) ================\")\n",
        "    df_raw = carregar_dados_brutos()\n",
        "    total_bruto = len(df_raw)\n",
        "\n",
        "    # 1. Limpeza\n",
        "    df_clean = df_raw.dropna(subset=[\"id_contribuinte\", \"valor_devido\", \"data_vencimento\"]).copy()\n",
        "    df_clean[\"valor_devido\"] = pd.to_numeric(df_clean[\"valor_devido\"], errors=\"coerce\")\n",
        "    df_clean = df_clean[df_clean[\"valor_devido\"] > 0]\n",
        "    df_clean.drop_duplicates(subset=[\"id_contribuinte\", \"data_vencimento\", \"tipo_tributo\"], inplace=True)\n",
        "    df_clean.to_csv(os.path.join(DIR_LIMPO, \"devedores_limpo.csv\"), index=False)\n",
        "\n",
        "    # 2. Engenharia de Atributos\n",
        "    df_transformed = df_clean.copy()\n",
        "    df_transformed[\"data_vencimento\"] = pd.to_datetime(df_transformed[\"data_vencimento\"], format=\"%Y-%m-%d\", errors=\"coerce\")\n",
        "    data_ref = pd.to_datetime(\"2026-10-27\")\n",
        "\n",
        "    df_transformed[\"dias_inadimplencia\"] = (data_ref - df_transformed[\"data_vencimento\"]).dt.days.clip(lower=0)\n",
        "    df_transformed[\"mes_vencimento\"] = df_transformed[\"data_vencimento\"].dt.month\n",
        "    df_transformed[\"trimestre_vencimento\"] = df_transformed[\"data_vencimento\"].dt.quarter\n",
        "\n",
        "    bins_valor = [0, 2000, 10000, 50000, np.inf]\n",
        "    labels_valor = [\"Baixo (< 2k)\", \"Médio (2k - 10k)\", \"Alto (10k - 50k)\", \"Crítico (> 50k)\"]\n",
        "    df_transformed[\"faixa_valor\"] = pd.cut(df_transformed[\"valor_devido\"], bins=bins_valor, labels=labels_valor)\n",
        "\n",
        "    # 3. Enriquecimento IBGE e XAI\n",
        "    df_ibge = carregar_ibge()\n",
        "    df_final = pd.merge(df_transformed, df_ibge, on=\"setor_urbano\", how=\"left\")\n",
        "    df_final[\"motivos_priorizacao_xai\"] = df_final.apply(gerar_motivos_xai, axis=1)\n",
        "\n",
        "    # Padronização de nome de coluna sem acentos\n",
        "    df_final[\"flag_prioridade_cobranca\"] = np.where(\n",
        "        (df_final[\"valor_devido\"] >= 10000.0) | (df_final[\"dias_inadimplencia\"] > 730), \"ALTA\", \"NORMAL\"\n",
        "    )\n",
        "    df_final.to_csv(os.path.join(DIR_PRONTO, \"devedores_enriquecido.csv\"), index=False)\n",
        "\n",
        "    # 4. Carga SQLite e Auditoria\n",
        "    conn = sqlite3.connect(DB_PATH)\n",
        "    df_final[\"data_vencimento\"] = df_final[\"data_vencimento\"].dt.strftime(\"%Y-%m-%d\")\n",
        "    df_final[\"faixa_valor\"] = df_final[\"faixa_valor\"].astype(str)\n",
        "    df_final[\"data_carga_etl\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "    df_final[\"usuario_executor\"] = \"etl_automation_user\"\n",
        "\n",
        "    df_final.to_sql(\"divida_ativa_sprint3\", conn, if_exists=\"replace\", index=False)\n",
        "    conn.commit()\n",
        "\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\"SELECT COUNT(*) FROM divida_ativa_sprint3\")\n",
        "    total_sqlite = cursor.fetchone()[0]\n",
        "    conn.close()\n",
        "\n",
        "    print(\"\\n---------------- LOGS DE VALIDAÇÃO DE QUALIDADE (ETL) ----------------\")\n",
        "    print(f\"Registros Brutos:          {total_bruto}\")\n",
        "    print(f\"Registros Limpos:           {len(df_clean)}\")\n",
        "    print(f\"Dataset Pronto:             {len(df_final)}\")\n",
        "    print(f\"Persistidos no SQLite:     {total_sqlite}\")\n",
        "    print(\"----------------------------------------------------------------------\\n\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    executar_etl()"
