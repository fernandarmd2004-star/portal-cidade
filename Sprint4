        "import os\n",
        "import joblib\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    classification_report,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    roc_auc_score,\n",
        ")\n",
        "from sklearn.model_selection import GridSearchCV\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "# 1. Garantir criação das pastas de destino\n",
        "os.makedirs(\"models\", exist_ok=True)\n",
        "os.makedirs(\"data/pronto\", exist_ok=True)\n",
        "\n",
        "# 2. Carregar a base de dados\n",
        "caminho = \"data/pronto/devedores_enriquecido.csv\"\n",
        "if not os.path.exists(caminho):\n",
        "  caminho = \"sprint3_extracted/data/pronto/devedores_enriquecido.csv\"\n",
        "\n",
        "df = pd.read_csv(caminho)\n",
        "\n",
        "# 3. Engenharia de Atributos: Score de Recuperabilidade (0 a 100)\n",
        "df[\"score_recuperabilidade\"] = (\n",
        "    (df[\"renda_media_setor\"] / 5000.0) * 35\n",
        "    + (df[\"idhm_setor\"]) * 25\n",
        "    + np.maximum(0, 100 - (df[\"dias_inadimplencia\"] / 365.0) * 15) * 0.4\n",
        ").clip(0, 100)\n",
        "\n",
        "df[\"faixa_recuperabilidade\"] = pd.cut(\n",
        "    df[\"score_recuperabilidade\"],\n",
        "    bins=[-1, 45, 70, 100],\n",
        "    labels=[\"Baixa\", \"Média\", \"Alta\"],\n",
        ")\n",
        "\n",
        "# 4. Variável Alvo sem colapso temporal de classes\n",
        "df[\"alvo_prioridade\"] = np.where(df[\"valor_devido\"] >= 20000.0, 1, 0)\n",
        "\n",
        "# 5. Split Temporal Estrito (E1: <=2023 Treino | >=2024 Teste)\n",
        "treino_df = df[df[\"exercicio\"] <= 2023].copy()\n",
        "teste_df = df[df[\"exercicio\"] >= 2024].copy()\n",
        "\n",
        "features = [\n",
        "    \"valor_devido\",\n",
        "    \"dias_inadimplencia\",\n",
        "    \"mes_vencimento\",\n",
        "    \"trimestre_vencimento\",\n",
        "    \"renda_media_setor\",\n",
        "    \"idhm_setor\",\n",
        "    \"populacao_estimada\",\n",
        "]\n",
        "\n",
        "X_train, y_train = treino_df[features], treino_df[\"alvo_prioridade\"]\n",
        "X_test, y_test = teste_df[features], teste_df[\"alvo_prioridade\"]\n",
        "\n",
        "# Normalização de dados\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "# 6. Modelos Baseline (E1)\n",
        "lr_model = LogisticRegression(random_state=42).fit(X_train_scaled, y_train)\n",
        "dt_model = DecisionTreeClassifier(max_depth=5, random_state=42).fit(\n",
        "    X_train, y_train\n",
        ")\n",
        "\n",
        "# 7. Modelo Final: Random Forest Otimizado (E2)\n",
        "param_grid = {\"n_estimators\": [50, 100], \"max_depth\": [3, 5]}\n",
        "grid = GridSearchCV(\n",
        "    RandomForestClassifier(random_state=42),\n",
        "    param_grid,\n",
        "    cv=3,\n",
        "    scoring=\"f1\",\n",
        "    n_jobs=-1,\n",
        ")\n",
        "grid.fit(X_train, y_train)\n",
        "best_rf = grid.best_estimator_\n",
        "\n",
        "# Avaliação\n",
        "y_pred_rf = best_rf.predict(X_test)\n",
        "y_proba_rf = best_rf.predict_proba(X_test)[:, 1]\n",
        "\n",
        "print(\"==================================================\")\n",
        "print(\"=== SPRINT 4: RESULTADOS DOS MODELOS DE IA ===\")\n",
        "print(\"==================================================\")\n",
        "print(f\"Treino (<= 2023): {len(X_train)} amostras\")\n",
        "print(f\"Teste  (>= 2024): {len(X_test)} amostras\")\n",
        "print(f\"\\nBaseline Regressão Logística (F1): {f1_score(y_test, lr_model.predict(X_test_scaled)):.4f}\")\n",
        "print(f\"Baseline Árvore de Decisão    (F1): {f1_score(y_test, dt_model.predict(X_test)):.4f}\")\n",
        "print(f\"\\n[Modelo Final - Random Forest Otimizado]\")\n",
        "print(f\"Acurácia: {accuracy_score(y_test, y_pred_rf):.2%}\")\n",
        "print(f\"Precisão: {precision_score(y_test, y_pred_rf):.4f}\")\n",
        "print(f\"Recall:   {recall_score(y_test, y_pred_rf):.4f}\")\n",
        "print(f\"F1-Score: {f1_score(y_test, y_pred_rf):.4f}\")\n",
        "print(f\"ROC-AUC:  {roc_auc_score(y_test, y_proba_rf):.4f}\")\n",
        "\n",
        "# 8. Serialização e Salvamento dos Ficheiros (E3)\n",
        "joblib.dump(best_rf, \"models/modelo_inadimplencia_rf.joblib\")\n",
        "joblib.dump(scaler, \"models/scaler.joblib\")\n",
        "df.to_csv(\"data/pronto/devedores_com_scores.csv\", index=False)\n",
        "\n",
        "print(\"\\n[+] Artefatos salvos em /models e data/pronto/devedores_com_scores.csv\")"
      ]
